# ========================================================
# MAN THRU — Environment Variables Template
# Copy this file to .env and insert your real credentials.
# NEVER commit real keys or secrets to public repositories.
# ========================================================

# Port for local development / Node.js production server (default: 3000)
PORT=3000

# Google Maps Platform / Places API Key (REQUIRED for Business Discovery)
# Standardized environment variable for Google Places API (New) Text Search
GOOGLE_MAPS_API_KEY=""
GOOGLE_PLACES_API_KEY=""

# Super Admin Master PIN for Owner Authentication & Approvals (default: 2580)
ADMIN_MASTER_PIN="2580"

# Optional Fast2SMS API Key for Indian mobile SMS OTP delivery
FAST2SMS_API_KEY="YOUR_FAST2SMS_API_KEY_HERE"

# Optional Gemini API Key for AI Festival & Marketing post generator
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"
